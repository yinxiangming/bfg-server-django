          },
          "data": {
            "content": {
              "en": "<h1>Delivery</h1><p>We ship across New Zealand. Typical options:</p><ul><li><strong>Standard:</strong> 2–5 business days (urban)</li><li><strong>Rural:</strong> allow extra time per carrier schedules</li><li><strong>Tracking:</strong> provided by email when your order ships</li></ul><p>Cut-off times and free-shipping thresholds may apply — see checkout for current details.</p>"
            }
          }
        }
      ]
