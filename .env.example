ENV=dev
DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=mysql://root:<password>@127.0.0.1:3306/packgo2
FRONTEND_URL=http://127.0.0.1:3019
SITE_NAME=PackGo V2
BFG_INSTANCE_TYPE=workspace
LOCAL_APPS=packgo

# ─── Media storage (S3) ────────────────────────────────────────────────
# Leave AWS_STORAGE_BUCKET_NAME empty to store uploads on the local filesystem
# (MEDIA_ROOT). Set it to route ALL uploads to S3 — no business-code change needed.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-2
# Optional CloudFront/CDN domain (no scheme) for public media, e.g. cdn.example.com
AWS_S3_CUSTOM_DOMAIN=
# Credentials are read by boto3 from the environment / IAM role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Private bucket for sensitive media (package photos, POD, customs docs, payment
# proofs) — served via short-lived signed URLs. Defaults to AWS_STORAGE_BUCKET_NAME
# if empty; set a dedicated private bucket in production for true isolation.
AWS_PRIVATE_STORAGE_BUCKET_NAME=
AWS_PRIVATE_URL_EXPIRE=3600
# Absolute base URL for media when storage returns relative paths (optional).
# Also required for feedback screenshots to embed in remote issue trackers
# (set to a PUBLIC API origin, e.g. https://api.example.com; localhost won't embed).
MEDIA_PUBLIC_BASE_URL=

# --- Address lookup (apps.geo) ---
# Server-side Google Maps: address typeahead and reverse geocoding for clients
# that cannot load Google's browser SDK. Deliberately not a workspace setting —
# custom_settings is readable by every staff user with settings access, and this
# is a billed credential. Give each environment its own key, restricted to the
# Places API (New) and the Geocoding API and to that environment's egress
# address. Without it the feature reports itself disabled however the workspace
# is configured. See apps/geo/README.md — note the IPv6 caveat when allow-listing.
# GOOGLE_MAPS_API_KEY=AIza...

# --- Feedback issue tracker ---
# Where user feedback (bug/feature) is filed. Default: github (zero-config back-compat).
FEEDBACK_TRACKER=github
# GitHub backend (used when FEEDBACK_TRACKER=github):
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=owner/repo
# Azure DevOps backend (used when FEEDBACK_TRACKER=azure):
# AZURE_DEVOPS_ORG_URL=https://dev.azure.com/markyin0801   # or a bare org name
# AZURE_DEVOPS_PROJECT=packgov2
# AZURE_DEVOPS_PAT=xxx                                      # PAT scope: Work Items (Read & write)
# AZURE_DEVOPS_BUG_TYPE=Bug                                 # feedback type=bug  -> this work item type
# AZURE_DEVOPS_FEATURE_TYPE=Issue                           # feedback type=feature -> this work item type
# AZURE_DEVOPS_AREA_PATH=packgov2                           # optional
# AZURE_DEVOPS_ITERATION_PATH=packgov2                      # optional
