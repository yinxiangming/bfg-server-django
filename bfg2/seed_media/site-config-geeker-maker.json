          },
          "data": {
            "content": {
              "en": "<h1>Contact Us</h1><p>Questions about stock, compatibility or your order? We are happy to help.</p><p><strong>Email:</strong> support@geeker.co.nz</p><p><strong>Hours:</strong> Monday – Friday, 9:00 – 17:00 NZST</p>"
            }
          }
        }
      ]
